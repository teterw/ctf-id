    tool "pdf2john"   "if it's password-protected"; cmd "pdf2john.pl $f > h.txt && john h.txt"
    tool "qpdf"       "decrypt once you know the pw"; cmd "qpdf --password=PW --decrypt $f out.pdf"
    ;;

  *"pcap"*|*"tcpdump"*|*"capture file"*)
    h "Network capture → TRAFFIC ANALYSIS"
    tool "Wireshark"  "GUI: Follow TCP Stream, File>Export Objects"; cmd "wireshark $f"
    tool "tshark"     "CLI filtering / field extraction"; cmd "tshark -r $f -Y http.request -T fields -e http.host -e http.request.uri"
    tool "strings"    "quick grep for creds/flags"; cmd "strings $f | grep -iE 'flag|pass|user'"
    tool "tcpflow"    "reassemble streams to files"; cmd "tcpflow -r $f"
    note "USB pcap? extract HID keystrokes. Export HTTP objects for files."
    ;;

  *"private key"*|*"public key"*|*"OpenSSH"*|*"PEM "*|*certificate*)
    h "Key / certificate → CRYPTO"
    tool "RsaCtfTool" "attack weak RSA (small n, common factors…)"; cmd "RsaCtfTool --publickey $f --private"
    tool "openssl"    "inspect the key/cert"; cmd "openssl rsa -in $f -text -noout"
    tool "ssh2john"   "crack a passphrase-protected SSH key"; cmd "ssh2john.py $f > h.txt && john h.txt"
    ;;

  *"filesystem"*|*"ext2"*|*"ext4"*|*"boot sector"*|*"disk image"*|*"QEMU"*)
    h "Disk / filesystem image → FORENSICS"
    tool "sleuthkit"  "fls/icat: list & recover files, incl. deleted"; cmd "fls -r $f    # then: icat $f <inode> > file"
    tool "testdisk"   "recover partitions/files (GUI-ish)"; cmd "testdisk $f"
    tool "mount"      "loop-mount and browse"; cmd "mkdir m && sudo mount -o loop,ro $f m"
    tool "binwalk"    "carve embedded content"; cmd "binwalk -e $f"
    note "memory dump instead? → volatility3 -f $f windows.info"
    ;;

  *"data"*|*"raw"*)
    h "Unknown / raw data → CARVE & IDENTIFY"
    note "'data' means file(1) couldn't ID it — inspect the bytes yourself:"
    if [ "${sz:-0}" -gt 100000000 ]; then
      note "${G}large unidentified file → probably a MEMORY DUMP${R}"
      tool "volatility3" "memory forensics"; cmd "vol -f $f windows.info   # or linux.bash / windows.pslist / windows.cmdline"
    fi
    tool "xxd"        "look at the header magic bytes"; cmd "xxd $f | head"
    tool "binwalk"    "find embedded/known signatures"; cmd "binwalk $f"
    tool "foremost"   "carve out known file types"; cmd "foremost -i $f -o carved/"
    tool "hexedit"    "edit magic bytes if header is corrupt"; cmd "hexedit $f"
    note "high entropy above? likely encrypted/packed. Low? maybe text encoding."
    note "try: base64 -d, xxd -r -p, or ${B}CyberChef${R} (gchq.github.io/CyberChef) with 'Magic'"
    ;;

  *"ASCII text"*|*"Unicode text"*|*"UTF-8"*|*"text"*)
    h "Text → ENCODING / CRYPTO / CODE"
    local an; an=$(analyze_text "$f")
    if [ -n "$an" ]; then
      printf '%s\n' "$an" | show_analysis
      h "general text tools"
    fi
    tool "cat/less"   "just read it"; cmd "less $f"
    tool "CyberChef"  "auto-detect encodings (base64/hex/rot/xor)"; cmd "https://gchq.github.io/CyberChef/   # paste, use the 'Magic' op"
    tool "name-that-hash" "identify a hash type"; cmd "nth -f $f"
    tool "ciphey/xortool" "auto-decrypt classic ciphers / xor"; cmd "xortool $f"
    note "looks like a hash? → hashcat/john. Looks like a cipher? → CyberChef/dcode.fr"
    note "RSA key/params (n, e, c)? →  RsaCtfTool --publickey key.pub --private"
    ;;



  *)
    h "No specific rule matched — general toolkit"
    tool "binwalk"   "find anything embedded"; cmd "binwalk -e $f"
    tool "foremost"  "carve known file types"; cmd "foremost -i $f -o carved/"
    tool "strings"   "readable text / flags"; cmd "strings -n6 $f | grep -iE 'flag|ctf|\\{'"
    tool "xxd"       "inspect header bytes"; cmd "xxd $f | head"
    tool "CyberChef" "throw it at the 'Magic' operation"; cmd "https://gchq.github.io/CyberChef/"
    ;;
  esac

  # ---- --run: execute the safe, read-only first checks -----------------------
  [ "$RUN" -eq 1 ] && [ -e "$f" ] && run_checks "$f" "$ft"

  # ---- binwalk embedded-file summary (all types, unless -q) ---------------
  if [ "$QUICK" -eq 0 ] && command -v binwalk >/dev/null && [ -f "$f" ]; then
    local bw
    # keep only result rows (they start with the decimal offset) — works for
    # binwalk v2 and v3, whose headers/footers differ
    bw=$(binwalk "$f" 2>/dev/null | awk '$1 ~ /^[0-9]+$/ { off=$1; hex=$2; $1=$2=""; sub(/^ +/, ""); printf "%-10s %-10s %s\n", off, hex, $0 }' | head -8)
    if [ "$(printf '%s' "$bw" | grep -c .)" -gt 1 ]; then
      h "binwalk sees embedded data (extract with: binwalk -e $f)"
      printf '  %sOFFSET     HEX        WHAT%s\n' "$DIM" "$R"
      printf '%s\n' "$bw" | sed 's/^/  /'
    fi
  fi

  # ---- --deep: extract and recurse (last, so the parent report reads first) -
  if [ "$DEEP" -eq 1 ] && [ -f "$f" ]; then deep_extract "$f" "$ft"; fi
  return 0
}

# ---- --run helpers ----------------------------------------------------------
RUN_DIR=""
# sets the global RUN_DIR — call it directly, not in $(...), or it's lost
ensure_run_dir(){
  [ -n "$RUN_DIR" ] || RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/ctf-id.XXXXXX")
}

# runc <label> <max lines> <command...> — run it with a timeout, show the head
# of the output, and shout about anything flag-shaped.
# runp <label> <max lines> <needs-binary> <pipeline> <file> — same, for a shell
# pipeline where "$1" is the file; shown to the user with the real filename.
runc(){
  local label="$1" max="$2"; shift 2
  command -v "$1" >/dev/null || { printf '  %s%s: %s not installed, skipped%s\n' "$DIM" "$label" "$1" "$R"; return; }
  printf '  %s%s%s %s$ %s%s\n' "$B" "$label" "$R" "$DIM" "$*" "$R"
  show_output "$max" "$(tmo 30 "$@" 2>&1 </dev/null)"
}
runp(){
  local label="$1" max="$2" need="$3" pipe="$4" file="$5"
  command -v "$need" >/dev/null || { printf '  %s%s: %s not installed, skipped%s\n' "$DIM" "$label" "$need" "$R"; return; }
  printf '  %s%s%s %s$ %s%s\n' "$B" "$label" "$R" "$DIM" "${pipe//\"\$1\"/$file}" "$R"
  show_output "$max" "$(tmo 30 sh -c "$pipe" _ "$file" 2>&1 </dev/null)"
}
show_output(){
  local max="$1" o
  o=$(printf '%s' "$2" | sed $'s/\x1b\\[[0-9;]*[A-Za-z]//g; s/\x1b\\]8;;[^\x1b]*\x1b\\\\//g')
  [ -z "$o" ] && { printf '     %s(no output)%s\n' "$DIM" "$R"; return; }
  printf '%s\n' "$o" | head -n "$max" | cut -c1-150 | sed 's/^/     /'
  local total; total=$(printf '%s\n' "$o" | wc -l)
  [ "$total" -gt "$max" ] && printf '     %s… %d more lines%s\n' "$DIM" $((total - max)) "$R"
  local flags; flags=$(printf '%s\n' "$o" | grep -aoE "$FLAG_RE" | sort -u | head -5)
  [ -n "$flags" ] && printf '%s\n' "$flags" | while IFS= read -r x; do printf '  %s★ possible flag: %s%s\n' "$B$G" "$x" "$R"; done
}

run_checks(){
  local f="$1" ft="$2" d
  h "--run: quick read-only checks"
  case "$ft" in
    *ELF*)
      runc checksec 10 checksec --file="$f"
      runp "risky functions" 10 strings "strings \"\$1\" | grep -xE 'gets|strcpy|strcat|sprintf|vsprintf|scanf|__isoc99_scanf|system|execve|popen|printf|mprotect' | sort -u | tr '\\n' ' '" "$f"
      note "gets/strcpy/scanf → overflow · printf with user input → format string · system/execve → ret2win/ret2libc target"
      runp "interesting strings" 12 strings "strings -n5 \"\$1\" | grep -iE 'flag|passw|secret|/bin/sh|cat |\\.txt' | sort -u" "$f" ;;
    *"PNG image"*|*"bitmap"*)
      runc exiftool 12 exiftool -S -Comment -Description -Title -Author -Artist -Software -Warning -ImageSize "$f"
      runc "QR/barcode" 4 zbarimg -q "$f"
      runp zsteg 12 zsteg "zsteg \"\$1\" 2>&1 | grep -vE ' \\.\\.( |\$)|^\\s*\$'" "$f"
      if [[ "$ft" == *bitmap* ]]; then
        ensure_run_dir; d=$RUN_DIR
        runc "steghide (empty password)" 4 steghide extract -sf "$f" -p "" -xf "$d/steghide.out" -f
      fi ;;
    *"JPEG image"*|*"GIF image"*|*"Web/P"*|*"WebP"*)
      runc "QR/barcode" 4 zbarimg -q "$f"
      runc exiftool 12 exiftool -S -Comment -Description -Title -Author -Artist -Software -Warning -ImageSize -GPSPosition "$f"
      ensure_run_dir; d=$RUN_DIR
      runc "steghide (empty password)" 4 steghide extract -sf "$f" -p "" -xf "$d/steghide.out" -f ;;
    *"WAVE"*|*"WAV "*|*"Audio"*|*"FLAC"*|*"Ogg"*)
      runc exiftool 8 exiftool -S -Comment -Title -Artist -Duration "$f"
      ensure_run_dir; d=$RUN_DIR
      if command -v sox >/dev/null; then
        runc spectrogram 2 sox "$f" -n spectrogram -o "$d/spectrogram.png"
        note "open it: xdg-open $d/spectrogram.png"
      else runc spectrogram 1 sox; fi ;;
    *PDF*)
      runc exiftool 10 exiftool -S -Title -Author -Subject -Keywords -Creator -Producer -Encryption "$f"
      runc "embedded files" 8 pdfdetach -list "$f"
      runc "text (first lines)" 12 pdftotext -layout "$f" - ;;
    *pcap*|*tcpdump*|*"capture file"*)
      runc "protocols" 20 tshark -r "$f" -qz io,phs
      runc "HTTP requests" 10 tshark -r "$f" -Y http.request -T fields -e ip.dst -e http.host -e http.request.uri
      runp "credentials seen" 10 tshark "tshark -r \"\$1\" -Y 'ftp.request.command in {\"USER\" \"PASS\"} || http.authorization' -T fields -e ftp.request.arg -e http.authorization 2>/dev/null | sort -u" "$f" ;;
    *"Zip archive"*|*"7-zip"*|*"RAR "*|*"gzip"*|*"bzip2"*|*"XZ "*|*"tar archive"*)
      runc "archive listing" 20 7z l -ba "$f"
      runp "encrypted entries" 5 7z "7z l -slt \"\$1\" | grep -c 'Encrypted = +'" "$f" ;;
    *directory*)
      if [ -d "$f/.git" ]; then
        runc "all commits" 15 git -C "$f" log --all --oneline
        runp "secrets in history" 10 git "git -C \"\$1\" log --all -p | grep -iE '^[+-].*(flag|pass|secret|key)' | sort -u" "$f"
        runc stashes 5 git -C "$f" stash list
      else note "--run: nothing to run on a plain directory"; fi ;;
    *SQLite*)
      runc tables 20 sqlite3 "$f" .tables
      runp "rows mentioning flag/pass" 10 sqlite3 "sqlite3 \"\$1\" .dump | grep -iE 'flag|pass|secret|ctf' " "$f" ;;
    *"Microsoft Word 2007"*|*"Microsoft Excel 2007"*|*"Microsoft PowerPoint 2007"*|*"Microsoft OOXML"*|*"Composite Document File"*)
      runc oleid 20 oleid "$f"
      runc olevba 25 olevba --decode "$f" ;;
    *)
      runc exiftool 8 exiftool -S -Comment -Description -Title -Author -Warning "$f" ;;
  esac
}

# ---- --deep ---------------------------------------------------------------------
deep_extract(){
  local f="$1" ft="$2" out n
  [ "$DEPTH" -ge "$MAX_DEPTH" ] && return
  [ "$DEEP_BUDGET" -le 0 ] && return
  ensure_run_dir; out=$(mktemp -d "$RUN_DIR/deep-XXXX")
  case "$ft" in
    *"Zip archive"*|*"7-zip"*|*"RAR "*|*"gzip"*|*"bzip2"*|*"XZ "*|*"tar archive"*|*cpio*|*"Java archive"*)
      if command -v 7z >/dev/null; then
        tmo 60 7z x -y -p"" -o"$out" "$f" >/dev/null 2>&1 \
          || { [ -z "$(ls -A "$out")" ] && note "--deep: couldn't extract (password protected?) — crack it, then extract by hand"; }
      elif command -v bsdtar >/dev/null; then tmo 60 bsdtar -xf "$f" -C "$out" 2>/dev/null
      fi ;;
    *)
      # anything else: let binwalk carve out embedded files
      command -v binwalk >/dev/null && (cd "$out" && tmo 60 binwalk -e -C "$out" "$f" >/dev/null 2>&1) ;;
  esac
  # ignore binwalk's copy of the whole input and empty files
  local files; files=$(find "$out" -type f -size +0 2>/dev/null | sort | head -n "$DEEP_BUDGET")
  files=$(printf '%s\n' "$files" | while IFS= read -r x; do
            [ -n "$x" ] && ! cmp -s "$x" "$f" && printf '%s\n' "$x"; done)
  n=$(printf '%s' "$files" | grep -c .)
  [ "$n" -eq 0 ] && { rmdir "$out" 2>/dev/null; return; }
  h "--deep: $n file(s) extracted from $(basename "$f") → $out"
  printf '%s\n' "$files" | sed "s|^$out/|  • |"
  DEPTH=$((DEPTH + 1))
  local x
  while IFS= read -r x; do
    [ "$DEEP_BUDGET" -le 0 ] && { note "--deep: file limit reached, stopping"; break; }
    DEEP_BUDGET=$((DEEP_BUDGET - 1))
    printf '\n%s↳ nested (level %d)%s\n' "$DIM" "$DEPTH" "$R"
    inspect "$x"
  done <<<"$files"
  DEPTH=$((DEPTH - 1))
}

print_missing(){
  [ -z "${MISSING//$'\n'/}" ] && return
  h "suggested tools you don't have yet"
  local k hint
  while IFS= read -r k; do
    [ -z "$k" ] && continue
    hint=$(install_hint "$k")
    printf '  %s✗%s %-22s %s%s%s\n' "$RED" "$R" "$k" "$DIM" "${hint:-(see the project website)}" "$R"
  done <<<"$MISSING"
}

if [ "$DOCTOR" -eq 1 ]; then
  echo "${B}ctf-id --doctor${R} ${DIM}— package manager: ${PM:-none detected}${R}"
  n_ok=0; n_miss=0
  while IFS='|' read -r key bins _; do
    [ -z "$key" ] || [ "$bins" = "~" ] && continue
    if have "$key"; then n_ok=$((n_ok+1)); printf '  %s✓%s %s\n' "$G" "$R" "$key"
    else n_miss=$((n_miss+1)); printf '  %s✗%s %-22s %s%s%s\n' "$RED" "$R" "$key" "$DIM" "$(install_hint "$key")" "$R"; fi
  done <<<"$TOOLS_DB"
  echo; echo "installed: $n_ok  missing: $n_miss"
  exit 0
fi

echo "${B}ctf-id${R} ${DIM}— file → suggested tools. Nothing here is run against the target automatically.${R}"
for f in "$@"; do inspect "$f"; done
print_missing
[ -n "$RUN_DIR" ] && echo "${DIM}--run/--deep output files are in: $RUN_DIR${R}"
hr
echo "${DIM}Tip:${R} nested/extracted files? run ${B}ctf-id${R} on them too."
