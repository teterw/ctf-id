            kind = next((v for k, v in magic.items() if r.startswith(k)), None)
            if not kind: continue
            rule(name, f"decodes to a {kind} file", f"{cmd} > decoded.bin && ctf-id decoded.bin")
            break
        rule(name, f"decodes to: {preview(r)}", *( [cmd] if cmd else [] ),
             notes=["decoded output may itself be encoded — CyberChef 'Magic' peels layers"])
        break

if not found and re.fullmatch(r'[+\-<>\[\].,\s]+', text) and '[' in text:
    rule("Brainfuck", "esoteric language program", notes=["run it: dcode.fr/brainfuck-language or `beef file`"])
if not found and re.search(r'(Ook[.?!]\s*){6,}', text):
    rule("Ook!", "Brainfuck variant", notes=["run it: dcode.fr/ook-language"])
if not found and text.startswith('begin ') and re.search(r'^end$', text, re.M):
    rule("uuencode", "old Unix binary-to-text encoding", f"uudecode {fname}")
if not found and re.fullmatch(r'[​‌‍⁠﻿]+', re.sub(r'[\x20-\x7e\s]', '', text) or 'x'):
    rule("Zero-width characters", "hidden data between the visible text", notes=["decode: 330k.github.io/misc_tools/unicode_steganography.html"])
if not found and re.search(r'[ \t]+$', text, re.M) and sum(1 for l in text.splitlines() if re.search(r'[ \t]{3,}$', l)) > 3:
