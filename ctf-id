        rule("Classical cipher?", f"letters only, index of coincidence {ic:.3f} (short text → unreliable)",
             notes=["try in order: Caesar → substitution (quipqiup.com) → Vigenère (dcode.fr)"])

print('\n'.join(out))
PY
}

# ---- structure checks (any file) --------------------------------------------
# Broken magic bytes, tampered PNG size, appended data, reversed/XOR'd files.
analyze_structure(){
  command -v python3 >/dev/null || return 0
  python3 - "$1" "$1" "$2" <<'PY' 2>/dev/null
import sys, struct, zlib

path, fname = sys.argv[1], sys.argv[2]
# header/XOR/reversal guesses only when file(1) couldn't identify it at all,
# otherwise e.g. a tar containing a zip looks like a "broken zip"
unknown = sys.argv[3].startswith('data') if len(sys.argv) > 3 else True
with open(path, 'rb') as fh:
    data = fh.read(64 * 1024 * 1024)
out = []
def T(name, desc): out.append(f"T\t{name}\t{desc}")
def C(cmd):        out.append(f"C\t{cmd}")
def N(msg):        out.append(f"N\t{msg}")

MAGIC = [(b'\x89PNG\r\n\x1a\n', 'PNG'), (b'\xff\xd8\xff', 'JPEG'), (b'GIF8', 'GIF'),
         (b'PK\x03\x04', 'ZIP'), (b'%PDF', 'PDF'), (b'\x7fELF', 'ELF'), (b'RIFF', 'RIFF/WAV'),
         (b'\x1f\x8b\x08', 'gzip'), (b'BZh', 'bzip2'), (b'7z\xbc\xaf\x27\x1c', '7z'),
         (b'Rar!\x1a\x07', 'RAR'), (b'\xfd7zXZ\x00', 'xz'), (b'OggS', 'Ogg'), (b'fLaC', 'FLAC'),
         (b'ID3', 'MP3'), (b'MZ', 'PE/EXE')]
def starts_known(b):
    return next((n for m, n in MAGIC if b.startswith(m)), None)
def hexb(b): return ''.join(f'\\x{c:02x}' for c in b)
def fixcmd(magic, off=0):
    return f"printf '{hexb(magic)}' | dd of={fname} bs=1 seek={off} conv=notrunc   # work on a copy!"

head = starts_known(data)

# ---- 1. damaged header: body says X but the magic bytes are wrong ----------
if unknown and not head and len(data) > 16:
    if data[12:16] == b'IHDR' or (b'IHDR' in data[:64] and b'IEND' in data[-32:]):
        T("Broken PNG header", "IHDR/IEND chunks present but the 8-byte signature is wrong")
        C(fixcmd(b'\x89PNG\r\n\x1a\n'))
    elif data[6:10] in (b'JFIF', b'Exif') or (data[-2:] == b'\xff\xd9' and b'JFIF' in data[:64]):
        T("Broken JPEG header", "JFIF/Exif marker present but the file doesn't start with FF D8 FF")
        C(fixcmd(b'\xff\xd8\xff\xe0'))
    elif data[8:12] == b'WAVE':
        T("Broken WAV header", "WAVE marker at offset 8 but no RIFF signature")
        C(fixcmd(b'RIFF'))
    elif b'PK\x05\x06' in data[-65557:] and b'PK\x01\x02' in data:
        T("Broken ZIP header", "central directory present but the first local header is damaged")
        C(fixcmd(b'PK\x03\x04'))
        C(f"zip -FF {fname} --out fixed.zip")
    elif b'%%EOF' in data[-1024:] and b' obj' in data:
        T("Broken PDF header", "PDF objects and %%EOF present but no %PDF at the start")
        C(fixcmd(b'%PDF-1.7\n'))
    elif b'.shstrtab' in data or b'GLIBC_' in data:
        T("Broken ELF header", "ELF section names / GLIBC symbols present but no \\x7fELF magic")
        C(fixcmd(b'\x7fELF'))

# ---- 2. whole file reversed or XOR'd with one byte -------------------------
if unknown and not head and len(data) > 16:
    rev = starts_known(data[::-1])
    if rev and rev not in ('PE/EXE', 'MP3', 'GIF', 'bzip2'):
        T("Reversed file", f"the bytes read backwards start like a {rev}")
        C(f"python3 -c \"d=open('{fname}','rb').read();open('reversed.bin','wb').write(d[::-1])\"")
    else:
        for m, name in MAGIC:
            if len(m) < 4: continue
            k = data[0] ^ m[0]
            if k and all(data[i] ^ k == m[i] for i in range(len(m))):
                T("XOR-encrypted file", f"XOR every byte with 0x{k:02x} → {name}")
                C(f"python3 -c \"d=open('{fname}','rb').read();open('xored.bin','wb').write(bytes(b^0x{k:02x} for b in d))\"")
                break

# ---- 3. PNG: CRC check on IHDR (classic "height was changed" trick) --------
if head == 'PNG' and data[12:16] == b'IHDR' and len(data) >= 33:
    w, h = struct.unpack('>II', data[16:24])
    rest = data[24:29]
    crc = struct.unpack('>I', data[29:33])[0]
    if zlib.crc32(data[12:29]) & 0xffffffff != crc:
        def ok(W, H): return zlib.crc32(b'IHDR' + struct.pack('>II', W, H) + rest) & 0xffffffff == crc
        # CTFs usually edit only one dimension: keep one fixed, search the other
        found = next(((w, H) for H in range(1, 10001) if ok(w, H)), None) \
             or next(((W, h) for W in range(1, 10001) if ok(W, h)), None)
        if found:
            T("PNG dimensions tampered", f"IHDR CRC doesn't match {w}x{h} — the real size is {found[0]}x{found[1]}")
            C(fixcmd(struct.pack('>II', *found), 16))
        else:
            T("PNG IHDR CRC mismatch", f"header says {w}x{h} but the CRC disagrees — width/height were probably edited")
            N("try increasing the height in a hex editor (bytes 20-23)")

# ---- 4. data appended after the end of the real file -----------------------
END = {'PNG': b'IEND\xaeB`\x82', 'JPEG': b'\xff\xd9', 'GIF': b'\x00;', 'PDF': b'%%EOF'}
if head in END:
    marker = END[head]
    i = data.rfind(marker) if head == 'PDF' else data.find(marker)
    if head == 'JPEG':
        i = data.rfind(marker)  # thumbnails contain their own FF D9
    if i != -1:
        end = i + len(marker)
        trail = data[end:].strip(b'\r\n\x00 ') if head == 'PDF' else data[end:]
        if head == 'PDF' and all(l.startswith(b'%') for l in trail.splitlines() if l.strip()):
            trail = b''  # trailing %-comment lines are normal (e.g. CUPS banners)
        if len(trail) >= 4:
            kind = starts_known(trail) or next((n for m, n in MAGIC if m in trail[:64]), None)
            desc = f"{len(data) - end} bytes after the end of the {head}"
            if kind: desc += f" — looks like a {kind}"
            T("Appended data", desc)
            C(f"dd if={fname} of=appended.bin bs=1 skip={end}")
            preview = trail[:48]
            if all(32 <= c < 127 or c in (9, 10, 13) for c in preview):
                N(f"starts with: {preview.decode().strip()[:48]}")

print('\n'.join(out))
PY
}

show_analysis(){
  local kind a b
  while IFS=$'\t' read -r kind a b; do
    case "$kind" in
      F) printf '\n  %s★ FLAG (decoded via %s): %s%s\n' "$B$G" "$a" "$b" "$R" ;;
      T) finding "$a" "$b" ;;
      C) cmd "$a" ;;
      N) note "$a" ;;
    esac
  done
}

