         notes=["or the Whitespace esolang if the file is mostly spaces/tabs"])

COMMON = set('the be to of and a in that have it for not on with he as you do at this but his by from they we '
             'say her she or an will my one all would there their what so up out if about who get which go me '
             'is are was were has had been flag key secret password'.split())
def english(s):
    w = re.findall(r'[a-z]+', s.lower())
    return sum(x in COMMON for x in w) / len(w) if len(w) >= 4 else 0

letters = [ch for ch in text.upper() if 'A' <= ch <= 'Z']
if not found and len(letters) >= 40 and len(letters) / max(len(compact), 1) > 0.7:
    cnt = collections.Counter(letters); N_ = len(letters)
    ic = sum(v * (v - 1) for v in cnt.values()) / (N_ * (N_ - 1))
    best = max(range(26), key=lambda k: english(caesar(text, k)))
    if english(text) >= 0.15: pass  # already plain English
    elif english(caesar(text, best)) >= 0.2:
